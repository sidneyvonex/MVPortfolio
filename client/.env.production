# Used by `vite build` (production mode).
# The site's Worker forwards /api/* to the API Worker over a service binding (worker/index.ts), so
# the browser calls the API on the site's own domain.
VITE_API_URL=/api

# Where scripts/prerender.mjs fetches content at build time. It runs in Node, outside the Worker,
# so it needs the API's absolute address.
PRERENDER_API_URL=https://mvportfolio-api.sidneygithu.workers.dev/api
