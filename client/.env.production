# Used by `vite build` (production mode) when deploying the client Worker.
# The client and API are separate Cloudflare Workers, so this must be an
# absolute URL — a relative "/api" resolves against the client's own origin
# and silently falls through to its SPA fallback instead of the API.
VITE_API_URL=https://mvportfolio-api.sidneygithu.workers.dev/api
