# Used by local Node-only tooling: drizzle-kit, src/db/seed.ts, src/scripts/create-admin.ts
# For the Worker itself, copy .dev.vars.example to .dev.vars instead (wrangler dev reads that),
# and `wrangler secret put <NAME>` for each secret in production.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
